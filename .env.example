
# LLM provider order
LLM_PROVIDER_ORDER=groq,openrouter,gemini,openai

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Nuitee / LiteAPI
NUITEE_API_KEY=
NUITEE_BASE_URL=https://api.liteapi.travel/v3.0

# Application
LOG_LEVEL=INFO

# API and local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
AUTH_DB_PATH=data/auth.sqlite3
ALLOW_PRODUCTION_BOOKING=false
ALLOW_FLIGHT_PREBOOK=false
ALLOW_FLIGHT_BOOKING=false
# Use LiteAPI's payment SDK; its sandbox mode is configured in the checkout UI.
FLIGHT_PAYMENT_MODE=nuitee_sdk

# In production, serve the app over HTTPS. The session cookie is Secure by default
# when APP_ENV=production; AUTH_COOKIE_SECURE can explicitly override that setting.
